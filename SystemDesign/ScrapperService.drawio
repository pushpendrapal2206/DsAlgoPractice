    <mxGraphModel dx="1018" dy="604" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="sWTl1USL2vOsfmpfYj-u-1" value="scrapper -&amp;gt; design a service that recieves list of urls&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;we want to scrap the link on the pages and images.&lt;/div&gt;&lt;div&gt;output -&amp;gt;&amp;nbsp;&lt;/div&gt;&lt;div&gt;page_urls - &amp;gt; list of images (reference of the image)&lt;/div&gt;&lt;div&gt;home to page to other pages via links to find all the images on the website.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;We have an exisintg API&lt;/div&gt;&lt;div&gt;1. POST /jobs&lt;/div&gt;&lt;div&gt;{urls: [&quot;abc.com&quot;, &quot;amazon.com&quot;]}&amp;nbsp; -&amp;gt; response ({job_id: 1234})&lt;/div&gt;&lt;div&gt;2. GET /jobs/{job_id}/status -&amp;gt;&amp;nbsp;&lt;/div&gt;&lt;div&gt;{&lt;/div&gt;&lt;div&gt;&quot;completed&quot;: &quot;1&quot;,&amp;nbsp;&lt;/div&gt;&lt;div&gt;&quot;inprogress&quot;: &quot;1&quot;&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;3. GET /jobs/{job_id}/results -&amp;gt;&amp;nbsp;&lt;/div&gt;&lt;div&gt;{&lt;/div&gt;&lt;div&gt;&quot;https://abc.com&quot;: [&quot;abc.com/img1.jpg&quot;],&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&quot;https://amazon.com&quot;: [&quot;amazon.com/img1.jpg&quot;]&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp;1. number of urls in the request --&amp;gt; 50 bytes -&amp;gt; 50 -&amp;gt; urls per job&lt;/div&gt;&lt;div&gt;2. GET /results api response payload size -&amp;gt; ~10 MB&lt;/div&gt;&lt;div&gt;Max jobs per day -&amp;gt; 100K&lt;/div&gt;&lt;div&gt;Max concurrent jobs -&amp;gt; ~500&lt;/div&gt;&lt;div&gt;Max data fetched daily -&amp;gt; 1 TB&lt;/div&gt;&lt;div&gt;Network bandwidth -&amp;gt; 100 MBPS&lt;/div&gt;&lt;div&gt;Number of session on the firewall -&amp;gt; 200K&lt;/div&gt;&lt;div&gt;2. max 2000 pages per urls. (scrap BFS fashion) -&amp;gt;&amp;nbsp;&lt;/div&gt;&lt;div&gt;POST /jobs -&amp;gt; 200 ms response time&lt;/div&gt;&lt;div&gt;GET /jobs/{job_id}/status -&amp;gt;&amp;nbsp;&lt;/div&gt;&lt;div&gt;GET /jobs/{job_id}/results -&amp;gt;&amp;nbsp;&lt;/div&gt;&lt;div&gt;3. NFR -&amp;gt;&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;number of jobs/day -&amp;gt; scalable as per number of jobs.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="60" y="90" width="710" height="510" as="geometry" />
        </mxCell>
